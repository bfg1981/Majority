  "rules": [
    {
      "id": "simple_majority",
      "name": "Simple majority (14 states)",
      "description": "Council simple majority: at least 14 of 27 member states vote in favour.",
      "scope": "council",
      "conditions": [
        {
          "type": "countGroups",
          "operator": ">=",
          "value": 14
        }
      ]
    },
    {
      "id": "qualified_majority",
      "name": "Qualified majority (15 states and 65% population)",
      "description": "Mock model of Council qualified majority: at least 15 of 27 member states and at least 65% of the EU population.",
      "scope": "council",
      "conditions": [
        {
          "type": "countGroups",
          "operator": ">=",
          "value": 15
        },
        {
          "type": "sum",
          "metric": "populationMillion",
          "operator": ">=",
          "threshold": {
            "kind": "fractionOfTotal",
            "metric": "populationMillion",
            "value": 0.65
          }
        }
      ]
    },
    {
      "id": "reinforced_qualified_majority",
      "name": "Reinforced qualified majority (20 states and 65% population)",
      "description": "Council reinforced qualified majority: used when the proposal is not from the Commission or the High Representative; at least 72% of member states and at least 65% of the EU population.",
      "scope": "council",
      "conditions": [
        {
          "type": "countGroups",
          "operator": ">=",
          "value": 20
        },
        {
          "type": "sum",
          "metric": "populationMillion",
          "operator": ">=",
          "threshold": {
            "kind": "fractionOfTotal",
            "metric": "populationMillion",
            "value": 0.65
          }
        }
      ]
    },
    {
      "id": "blocking_minority",
      "name": "Blocking minority (4 states and >35% population)",
      "description": "Mock model of a Council blocking minority: at least four member states representing more than 35% of the EU population.",
      "scope": "council",
      "conditions": [
        {
          "type": "countGroups",
          "operator": ">=",
          "value": 4
        },
        {
          "type": "sum",
          "metric": "populationMillion",
          "operator": ">",
          "threshold": {
            "kind": "fractionOfTotal",
            "metric": "populationMillion",
            "value": 0.35
          }
        }
      ]
    },
    {
      "id": "unanimity",
      "name": "Unanimity (27 states)",
      "description": "Council unanimity modelled as all 27 member states voting in favour. This mock does not model abstentions.",
      "scope": "council",
      "conditions": [
        {
          "type": "countGroups",
          "operator": ">=",
          "value": 27
        }
      ]
    }
  ],
  "metadata": {
    "region": "EU",
    "period": "2024",
    "mock": true,
    "notes": "Deliberately unserious member-state names and rounded population values. This is intended as a modelling sketch for Council voting behavior, not as source-quality EU Council data. Special voting cases where only some member states participate are not modelled here.",
